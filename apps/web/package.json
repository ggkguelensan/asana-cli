{
  "name": "@asana-cli/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "check": "bun run build && bun run test"
  },
  "dependencies": {
    "jotai": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@asana-cli/contracts": "workspace:*",
    "@asana-cli/core": "workspace:*",
    "@asana-cli/service-client": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
