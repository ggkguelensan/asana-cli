{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/cli/src/index.ts",
    "tests/**/*.test.ts",
    "apps/web/tests/**/*.test.ts",
    "packages/*/tests/**/*.test.ts",
    "apps/cli/build.ts"
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    "threshold": 5
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "ignoreExports": [
    {
      "file": "integrations/clients.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "apps/cli/src/client-adapter-specs.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "apps/cli/src/integrations/schemas.ts",
      "exports": [
        "*"
      ]
    }
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "private-type-leaks": "warn",
    "stale-suppressions": "warn",
    "require-suppression-reason": "error"
  },
  "audit": {
    "deadCodeBaseline": ".fallow-dead-code-baseline.json",
    "healthBaseline": ".fallow-health-baseline.json",
    "dupesBaseline": ".fallow-dupes-baseline.json"
  }
}
