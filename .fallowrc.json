{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.ts"],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    "threshold": 5
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "ignoreExports": [
    {
      "file": "integrations/clients.ts",
      "exports": ["*"]
    },
    {
      "file": "src/client-adapter-specs.ts",
      "exports": ["*"]
    },
    {
      "file": "src/integrations/schemas.ts",
      "exports": ["*"]
    }
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "private-type-leaks": "warn",
    "stale-suppressions": "warn",
    "require-suppression-reason": "error"
  }
}
